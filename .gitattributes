* text=auto

# Repository text formats use LF on every platform to avoid merge-only diffs.
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Binary assets must never be line-ending normalized.
*.ico binary
*.glb binary
*.gltf text eol=lf
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
