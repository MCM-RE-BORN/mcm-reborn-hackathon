# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only - never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6

# External image processing remains opt-in. LIVE also requires a deployed
# privacy notice/version and server-side analysis-consent verification.
ENABLE_EXTERNAL_AI=false
EXTERNAL_AI_PRIVACY_NOTICE_VERSION=

# DEMO_FIXTURE | SEEDED_ESTIMATE | LIVE
AI_MODE=DEMO_FIXTURE

# PRIMARY_SCENARIO | STATIC
DEMO_TIMELINE_PROFILE=PRIMARY_SCENARIO
DEMO_SCENARIO_KEY=MCM_BACKPACK_CHANGE_APPROVED_20260817

# Demo-only switch. Enable only in an access-controlled demo environment.
ENABLE_DEMO_LOGIN=false
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
